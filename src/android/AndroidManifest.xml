<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.skyflap.game" android:versionCode="6" android:versionName="1.5.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true" android:allowBackup="true"
        android:theme="@style/Game">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="portrait" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".ApkProvider" android:authorities="com.skyflap.game.updates"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
